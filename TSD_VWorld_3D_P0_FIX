
<!doctype html>
<html lang="ko">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>TSD P0 | VWorld 3D 연결 진단 v2</title>
<style>
*{box-sizing:border-box}
body{margin:0;background:#091722;color:#ecf3fb;font:14px/1.5 system-ui,sans-serif}
header{padding:12px 16px;background:#102435}
h1{font-size:16px;margin:0 0 5px}
small{color:#b5c7d7}
input,button{padding:9px;font:inherit;border-radius:5px}
input{width:min(95%,420px);background:#fff;border:0}
button{cursor:pointer;border:1px solid #52718a;background:#183b54;color:white}
button:disabled{opacity:.4;cursor:default}
#map{height:68vh;min-height:350px;background:#263b49}
#status{padding:12px 16px;white-space:pre-wrap;background:#0d2232}
#log{margin:0;padding:12px 16px;white-space:pre-wrap;max-height:190px;overflow:auto;color:#b9d6e9;font-size:12px}
label{display:inline-block;margin:5px 0}
.note{padding:0 16px 10px;color:#b5c7d7}
</style>
</head>
<body>
<header>
<h1>TSD P0 · 브이월드 실제 3D 지형 진단 v2</h1>
<small>북한산 백운대 (37.6587, 126.9770) · 공식 WebGL 3.0 API · 가상 지형 없음</small>
<div>
<label>API 인증키
<input id="key" type="password" placeholder="브이월드 인증키 (이 브라우저에서만 사용)" autocomplete="off">
</label>
<button id="load">3D 지도 연결</button>
<button id="oblique" disabled>경사 -65°</button>
<button id="nadir" disabled>직하방 -90°</button>
<button id="copy">진단 기록 복사</button>
</div>
</header>

<div id="map"></div>
<div id="status" role="status">인증키를 입력하고 3D 지도 연결을 누르세요.</div>
<pre id="log"></pre>
<div class="note">키는 저장하거나 진단 기록에 포함하지 않습니다. 오류가 발생하면 ‘진단 기록 복사’를 이용하세요. 실제 지도 표시는 브이월드 서비스와 인증 상태에 따릅니다.</div>

<script>
'use strict';

const el=id=>document.getElementById(id);
let viewer=null,map=null,started=false,completed=false,timeoutId=null;
const log=[];

function report(msg){
  const t=new Date().toLocaleTimeString('ko-KR');
  log.push('['+t+'] '+msg);
  el('log').textContent=log.join('\n');
  el('status').textContent=msg;
}

function enableCamera(){
  el('oblique').disabled=el('nadir').disabled=!viewer;
}

function moveCamera(pitch){
  if(!viewer||!window.Cesium){
    report('카메라 조작 불가: Cesium 뷰어 미준비');
    return;
  }
  try{
    viewer.camera.setView({
      destination:Cesium.Cartesian3.fromDegrees(126.9770,37.6587,3500),
      orientation:{
        heading:0,
        pitch:Cesium.Math.toRadians(pitch),
        roll:0
      }
    });
    report('카메라 시점 '+pitch+'° 적용 (지형 로딩 성공 여부는 별도 확인 필요)');
  }catch(e){
    report('카메라 이동 실패: '+e.message);
  }
}

el('oblique').onclick=()=>moveCamera(-65);
el('nadir').onclick=()=>moveCamera(-90);

el('copy').onclick=()=>{
  const result=log.join('\n')||'기록 없음';
  if(navigator.clipboard?.writeText){
    navigator.clipboard.writeText(result)
      .then(()=>report('진단 기록 복사 완료'))
      .catch(()=>report('복사 실패: 브라우저 권한 확인'));
  }else{
    report('클립보드 미지원: 화면의 진단 기록을 선택해 복사하세요');
  }
};

window.addEventListener('error',e=>{
  if(started)report('스크립트 오류: '+String(e.message||'알 수 없는 오류'));
});

window.addEventListener('unhandledrejection',e=>{
  if(started)report('비동기 오류: '+String(e.reason?.message||e.reason||'알 수 없는 오류'));
});

el('load').onclick=()=>{
  if(started){
    report('이미 시작했습니다. 재시도하려면 페이지를 새로고침하세요.');
    return;
  }

  const key=el('key').value.trim();
  if(!/^[A-Za-z0-9-]{12,128}$/.test(key)){
    report('인증키 형식을 확인하세요.');
    return;
  }

  started=true;
  el('load').disabled=true;
  report('1/4 공식 WebGL 3.0 스크립트 요청');

  const script=document.createElement('script');
  script.src='https://map.vworld.kr/js/webglMapInit.js.do?version=3.0&apiKey='+encodeURIComponent(key);

  script.onerror=()=>{
    report('스크립트 요청 실패: 서버 접근·도메인·인증 설정 확인');
    el('load').disabled=false;
    started=false;
  };

  script.onload=()=>{
    report('2/4 스크립트 응답 완료 · vw='+Boolean(window.vw));

    if(!window.vw?.Map||!window.vw?.CameraPosition){
      report('초기화 실패: 브이월드 지도 API 객체가 없습니다. 인증키·도메인·서버 응답을 확인하세요.');
      return;
    }

    try{
      vw.ws3dInitCallBack=function(){
        completed=true;
        clearTimeout(timeoutId);
        viewer=window.ws3d?.viewer||null;
        enableCamera();
        report(viewer
          ?'4/4 3D 엔진 초기화 콜백 확인 · 카메라 제어 가능 (실제 지형 화면 확인 필요)'
          :'4/4 초기화 콜백 확인 · ws3d.viewer 없음');
      };

      const options={
        mapId:'map',
        initPosition:new vw.CameraPosition(
          new vw.CoordZ(126.9770,37.6587,3500),
          new vw.Direction(0,-65,0)
        ),
        logo:true,
        navigation:true
      };

      map=new vw.Map();
      map.setOption(options);
      report('3/4 지도 생성 요청 중');
      map.start();
      report('3/4 map.start() 호출 완료 · 초기화 콜백 대기');

      timeoutId=setTimeout(()=>{
        if(!completed){
          const ready=Boolean(window.ws3d?.viewer);
          report('초기화 지연(20초): 콜백 미수신 · ws3d.viewer='+ready+' · 인증 도메인, 개발자도구 Network/Console 확인');
          if(ready){
            viewer=window.ws3d.viewer;
            enableCamera();
          }
        }
      },20000);

    }catch(e){
      report('지도 생성 실패: '+String(e.stack||e.message||e));
    }
  };

  document.head.appendChild(script);
};
</script>
</body>
</html>
